{
  "manifest_version": 3,
  "name": "Mosaic for Reddit",
  "description": "Browse Reddit media in a beautiful masonry layout.",
  "version": "0.0.1",

  "action": {
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.reddit.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],

  "permissions": [],

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
